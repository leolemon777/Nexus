{
  "name": "nexus-rust",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell with a Rust protocol core for industrial serial and Modbus tooling.",
  "productName": "Nexus 2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:rust-core": "cargo build --manifest-path rust-core/Cargo.toml",
    "package:portable": "pwsh -NoProfile -File scripts/package-portable.ps1",
    "postinstall": "node scripts/ensure-electron.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "test:electron": "node --test electron/*.test.cjs",
    "test:rust-core": "cargo test --manifest-path rust-core/Cargo.toml",
    "fmt:rust-core": "cargo fmt --manifest-path rust-core/Cargo.toml --all -- --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "electron": "43.1.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.nexus2.app",
    "productName": "Nexus 2.0",
    "directories": {
      "output": "output/installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus 2.0"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "index.html",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "rust-core/target/release/nexus-rust-core.exe",
        "to": "bin/nexus-rust-core.exe"
      }
    ]
  }
}
