{
  "metadata": [
    {
      "src": [{ "files": ["**/*.csproj"], "src": "../src" }],
      "dest": "api",
      "properties": {
        "TargetFramework": "netstandard2.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.md", "**/*.yml"], "exclude": ["_site/**", "api/**", "obj/**"] }
    ],
    "resource": [{ "files": ["images/**"] }],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Nexus",
      "_appTitle": "Nexus — 工业通讯库",
      "_appFooter": "Nexus © 2024-2026",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/nexus-comm/nexus"
      }
    }
  }
}
