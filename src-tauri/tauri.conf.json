{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus 2.0",
  "version": "0.1.0",
  "identifier": "com.nexus.protocol-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus 2.0 · 串口实验室",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

