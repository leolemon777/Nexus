<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nexus-iot/nexus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nexus-iot/nexus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>industrial;plc;modbus;siemens;mitsubishi;omron;automation;iot;protocol</PackageTags>
    <Description>Nexus Industrial Communication Library — open-source .NET library for PLC and industrial device communication</Description>
    <Authors>Nexus Team</Authors>
    <Company>Nexus</Company>

    <!-- Source Link for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Canonical version source for the WHOLE solution.
      Versioning is driven by MinVer from git tags (prefix `v`, e.g. `v1.0.0`, `v1.1.0-beta.1`).
      Do NOT add a literal <Version> here — that would override MinVer.
      Individual csproj files MUST also avoid hardcoding <Version>; doing so silently overrides
      MinVer for that project (historically most src/*.csproj did this — see docs/RELEASE_RUNBOOK.md
      "Known packaging inconsistencies"). With no git tags present, MinVer falls back to
      <VersionPrefix>1.0.0</VersionPrefix> plus commit-count prerelease metadata.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="5.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Test projects should not be packaged -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
