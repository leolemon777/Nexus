<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Form style: soft  (若 .NET 报 mscorlib 错，把上面 assembly=mscorlib 改为 System.Runtime) -->
  <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
  <CornerRadius x:Key="Radius.Md">6</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
  <Thickness x:Key="Pad.Card">14</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">13</sys:Double>
  <sys:Double x:Key="Font.SizeH">14</sys:Double>
  <sys:Double x:Key="Font.SizeHero">26</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">18</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.10" Color="Black"/>
</ResourceDictionary>
