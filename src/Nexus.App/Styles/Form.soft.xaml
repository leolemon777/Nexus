<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Form style: soft  (若 .NET 报 mscorlib 错，把上面 assembly=mscorlib 改为 System.Runtime) -->
  <CornerRadius x:Key="Radius.Lg">16</CornerRadius>
  <CornerRadius x:Key="Radius.Md">11</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">7</CornerRadius>
  <Thickness x:Key="Pad.Card">24</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">14</sys:Double>
  <sys:Double x:Key="Font.SizeH">20</sys:Double>
  <sys:Double x:Key="Font.SizeHero">34</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">44</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.30" Color="Black"/>
</ResourceDictionary>
