<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Form style: sharp  (若 .NET 报 mscorlib 错，把上面 assembly=System.Runtime 改为 mscorlib) -->
  <CornerRadius x:Key="Radius.Lg">3</CornerRadius>
  <CornerRadius x:Key="Radius.Md">3</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">2</CornerRadius>
  <Thickness x:Key="Pad.Card">20</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Space Grotesk, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">13</sys:Double>
  <sys:Double x:Key="Font.SizeH">17</sys:Double>
  <sys:Double x:Key="Font.SizeHero">30</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">42</sys:Double>
  <DropShadowEffect x:Key="CardEffect" Opacity="0"/>
</ResourceDictionary>
