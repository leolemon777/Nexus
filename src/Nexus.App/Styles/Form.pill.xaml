<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Form style: pill  (若 .NET 报 mscorlib 错，把上面 assembly=System.Runtime 改为 mscorlib) -->
  <CornerRadius x:Key="Radius.Lg">24</CornerRadius>
  <CornerRadius x:Key="Radius.Md">999</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">16</CornerRadius>
  <Thickness x:Key="Pad.Card">24</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">14</sys:Double>
  <sys:Double x:Key="Font.SizeH">21</sys:Double>
  <sys:Double x:Key="Font.SizeHero">34</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">46</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.30" Color="Black"/>
</ResourceDictionary>
