<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Form style: flat  (若 .NET 报 mscorlib 错，把上面 assembly=System.Runtime 改为 mscorlib) -->
  <CornerRadius x:Key="Radius.Lg">12</CornerRadius>
  <CornerRadius x:Key="Radius.Md">9</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
  <Thickness x:Key="Pad.Card">30</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">14</sys:Double>
  <sys:Double x:Key="Font.SizeH">19</sys:Double>
  <sys:Double x:Key="Font.SizeHero">32</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">44</sys:Double>
  <DropShadowEffect x:Key="CardEffect" Opacity="0"/>
</ResourceDictionary>
