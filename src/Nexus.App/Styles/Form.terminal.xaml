<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Form style: terminal  (若 .NET 报 mscorlib 错，把上面 assembly=mscorlib 改为 System.Runtime) -->
  <CornerRadius x:Key="Radius.Lg">4</CornerRadius>
  <CornerRadius x:Key="Radius.Md">4</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">3</CornerRadius>
  <Thickness x:Key="Pad.Card">20</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">JetBrains Mono, Cascadia Mono, Microsoft YaHei UI, Consolas</FontFamily>
  <sys:Double x:Key="Font.Size">13</sys:Double>
  <sys:Double x:Key="Font.SizeH">16</sys:Double>
  <sys:Double x:Key="Font.SizeHero">26</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">40</sys:Double>
  <DropShadowEffect x:Key="CardEffect" Opacity="0"/>
</ResourceDictionary>
