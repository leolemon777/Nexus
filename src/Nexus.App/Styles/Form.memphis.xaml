<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Form style: memphis  (若 .NET 报 mscorlib 错，把上面 assembly=mscorlib 改为 System.Runtime) -->
  <CornerRadius x:Key="Radius.Lg">16</CornerRadius>
  <CornerRadius x:Key="Radius.Md">12</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">8</CornerRadius>
  <Thickness x:Key="Pad.Card">24</Thickness>
  <Thickness x:Key="Border.Thickness">2</Thickness>
  <FontFamily x:Key="Font.Family">Space Grotesk, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">14</sys:Double>
  <sys:Double x:Key="Font.SizeH">22</sys:Double>
  <sys:Double x:Key="Font.SizeHero">38</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">46</sys:Double>
  <DropShadowEffect x:Key="CardEffect" Opacity="0"/>
</ResourceDictionary>
