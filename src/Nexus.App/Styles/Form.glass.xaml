<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Form style: glass  (若 .NET 报 mscorlib 错，把上面 assembly=mscorlib 改为 System.Runtime) -->
  <CornerRadius x:Key="Radius.Lg">18</CornerRadius>
  <CornerRadius x:Key="Radius.Md">12</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">9</CornerRadius>
  <Thickness x:Key="Pad.Card">24</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">14</sys:Double>
  <sys:Double x:Key="Font.SizeH">20</sys:Double>
  <sys:Double x:Key="Font.SizeHero">34</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">44</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.30" Color="Black"/>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Color.Surface2}" Opacity="0.72"/>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Lg}"/>
    <Setter Property="Padding" Value="{DynamicResource Pad.Card}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="halo" Margin="-3" CornerRadius="{DynamicResource Radius.Md}"
                    Background="{DynamicResource Brush.AccentSoft}" Opacity="0"/>
            <Border x:Name="b" Background="{DynamicResource Brush.AccentGrad}"
                    BorderBrush="{DynamicResource Brush.AccentLine}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="halo" Property="Opacity" Value="0.55"/>
              <Setter TargetName="b" Property="Opacity" Value="0.94"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Margin" Value="0,1,0,-1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.38"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="fill" Background="{DynamicResource Brush.Surface2}" Opacity="0.58"
                    CornerRadius="{DynamicResource Radius.Md}"/>
            <Border x:Name="b" Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Line2}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="fill" Property="Opacity" Value="0.82"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Brush.AccentLine}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Margin" Value="0,1,0,-1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
