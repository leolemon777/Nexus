<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Form style: fluent  (若 .NET 报 mscorlib 错，把上面 assembly=System.Runtime 改为 mscorlib) -->
  <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
  <CornerRadius x:Key="Radius.Md">6</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
  <Thickness x:Key="Pad.Card">20</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Segoe UI, Microsoft YaHei UI, Manrope</FontFamily>
  <sys:Double x:Key="Font.Size">13.5</sys:Double>
  <sys:Double x:Key="Font.SizeH">20</sys:Double>
  <sys:Double x:Key="Font.SizeHero">30</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">42</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.30" Color="Black"/>
</ResourceDictionary>
