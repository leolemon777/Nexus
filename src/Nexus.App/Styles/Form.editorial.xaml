<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Form style: editorial  (若 .NET 报 mscorlib 错，把上面 assembly=System.Runtime 改为 mscorlib) -->
  <CornerRadius x:Key="Radius.Lg">10</CornerRadius>
  <CornerRadius x:Key="Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
  <Thickness x:Key="Pad.Card">30</Thickness>
  <Thickness x:Key="Border.Thickness">1</Thickness>
  <FontFamily x:Key="Font.Family">Manrope, Microsoft YaHei UI, Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size">15</sys:Double>
  <sys:Double x:Key="Font.SizeH">30</sys:Double>
  <sys:Double x:Key="Font.SizeHero">46</sys:Double>
  <sys:Double x:Key="Font.SizeReadout">54</sys:Double>
  <DropShadowEffect x:Key="CardEffect" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.30" Color="Black"/>
</ResourceDictionary>
