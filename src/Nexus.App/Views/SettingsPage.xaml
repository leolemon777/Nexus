<Page x:Class="Nexus.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Nexus.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=True}"
      Background="{DynamicResource Brush.Bg}"
      AutomationProperties.AutomationId="SettingsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>

            <!-- 关于 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="关于" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{DynamicResource H1}" Margin="0,0,0,4">
                        <Run Text="Nexus"/>
                        <Run Text="{Binding AppVersion, Mode=OneWay, FallbackValue=v0.0.0}"
                             FontSize="14" Foreground="{DynamicResource Brush.Text3}"/>
                    </TextBlock>
                    <TextBlock Text="开源免费的工业通讯库 &amp; 调试工具" Style="{DynamicResource Body}" Margin="0,0,0,8"/>
                    <TextBlock Style="{DynamicResource Body}" Margin="0,0,0,4">
                        <Run Foreground="{DynamicResource Brush.Text3}" Text="协议: MIT · 永久免费 · 无任何限制"/>
                    </TextBlock>
                    <TextBlock Style="{DynamicResource Body}" Margin="0,0,0,4">
                        <Run Foreground="{DynamicResource Brush.Text3}" Text="目标: 支持 Modbus / Siemens / Mitsubishi / Omron / AB 等主流 PLC 协议"/>
                    </TextBlock>

                    <!-- 当前主题信息（运行时反映 ThemeManager 实际应用值） -->
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{DynamicResource Radius.Sm}" Padding="12,8" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center">
                                <Run Text="配色: "/>
                                <Run Text="{Binding SelectedColor, Mode=OneWay, FallbackValue=mono}"/>
                                <Run Text=" · 款式: "/>
                                <Run Text="{Binding SelectedForm, Mode=OneWay, FallbackValue=soft}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 主题 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="主题" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{DynamicResource Body}" Margin="0,0,0,8"
                               Foreground="{DynamicResource Brush.Text3}"
                               Text="实时切换配色与款式；选择会保存到 %APPDATA%/Nexus/settings.json，下次启动自动恢复。"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="配色" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.AutomationId="ThemeColorComboBox"
                                  MinWidth="200"
                                  ItemsSource="{Binding AvailableColors, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedColor, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="3" Text="款式" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="4"
                                  AutomationProperties.AutomationId="ThemeFormComboBox"
                                  MinWidth="200"
                                  ItemsSource="{Binding AvailableForms, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedForm, Mode=TwoWay}"/>
                    </Grid>

                    <Button Content="恢复默认 (mono / soft)"
                            AutomationProperties.AutomationId="ResetThemeButton"
                            Style="{DynamicResource Button.Ghost}"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetThemeCommand, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!-- 写入确认 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="写入安全" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <CheckBox Content="写入 PLC 前弹出确认对话框（默认开启，建议保持）"
                              AutomationProperties.AutomationId="WriteConfirmToggle"
                              IsChecked="{Binding WriteConfirmEnabled, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 日志查看器 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="日志查看器（环形缓冲，已脱敏）" Style="{DynamicResource Label}"/>
                        <TextBlock Style="{DynamicResource Body}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Text3}" FontSize="11"
                                   Text="{Binding LogAvailability, Mode=OneWay, FallbackValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="刷新"
                                AutomationProperties.AutomationId="RefreshLogButton"
                                Style="{DynamicResource Button.Primary}"
                                Margin="0,0,8,0"
                                Command="{Binding RefreshLogCommand, Mode=OneWay}"/>
                        <Button Content="清空缓冲"
                                AutomationProperties.AutomationId="ClearLogButton"
                                Style="{DynamicResource Button.Ghost}"
                                Command="{Binding ClearLogCommand, Mode=OneWay}"/>
                    </StackPanel>
                    <!-- 虚拟化：日志量可能达数百行，启用 ContainerCoGen + VirtualizingStackPanel -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            MaxHeight="320">
                        <ListBox x:Name="LogListBox"
                                 AutomationProperties.AutomationId="SettingsLogListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 ItemsSource="{Binding LogLines, Mode=OneWay}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,2"/>
                                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 连接模板（只读） -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="已保存的连接模板（只读）" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{DynamicResource Body}" Margin="0,0,0,8"
                               Foreground="{DynamicResource Brush.Text3}"
                               Text="名称 + 协议。编辑/新增在各协议页进行。"/>
                    <Border BorderBrush="{DynamicResource Brush.Divider}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            MaxHeight="240">
                        <ListView AutomationProperties.AutomationId="SettingsTemplateListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ItemsSource="{Binding Templates, Mode=OneWay}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="220"
                                                    DisplayMemberBinding="{Binding Name, Mode=OneWay, FallbackValue=(unnamed)}"/>
                                    <GridViewColumn Header="协议" Width="160"
                                                    DisplayMemberBinding="{Binding Protocol, Mode=OneWay, FallbackValue=-}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
