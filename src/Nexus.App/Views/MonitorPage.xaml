<Page x:Class="Nexus.App.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="实时监控" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="添加设备" Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"/>
                            <Button Content="全部刷新" Style="{DynamicResource Button.Ghost}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{DynamicResource Body}" Margin="0,12,0,0"
                               Text="实时监控多个设备的连接状态和数据变化。添加设备后，可配置轮询地址和刷新周期。"/>
                </StackPanel>
            </Border>

            <!-- 占位：设备卡片列表 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16" Opacity="0.6">
                <StackPanel HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="暂无监控设备" Style="{DynamicResource H1}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="点击「添加设备」开始监控" Style="{DynamicResource Body}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
