<Page x:Class="Nexus.App.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Nexus.App.Views"
      xmlns:controls="clr-namespace:Nexus.App.Controls"
      Background="{DynamicResource Brush.Bg}">
    <Page.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <local:NonZeroToVisibleConverter x:Key="NonZeroToVisible"/>
        <local:BoolToColorConverter x:Key="BoolToColor"/>
        <local:QualityToColorConverter x:Key="QualityToColor"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Style="{DynamicResource Card}" Margin="12,12,12,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"
                            Command="{Binding TogglePollingCommand}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶ Start"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                                <Setter Property="Text" Value="⏸ Stop"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button Content="Export CSV" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,0"
                            Command="{Binding ExportCsvCommand}"/>
                    <Button Content="Export JSON" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,0"
                            Command="{Binding ExportJsonCommand}"/>
                    <Button Content="Clear History" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,0"
                            Command="{Binding ClearHistoryCommand}"/>
                    <Button Content="Clear All" Style="{DynamicResource Button.Danger}" Margin="0,0,8,0"
                            Command="{Binding ClearAllMonitoredAddressesCommand}"/>
                    <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="{DynamicResource Radius.Md}"
                            Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Window (s): " Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChartTimeWindowSeconds}" Style="{DynamicResource Body}"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsPolling, Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Style="{DynamicResource Body}" VerticalAlignment="Center">
                        <Run Text="Addresses: "/>
                        <Run Text="{Binding MonitoredCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" | Polling: "/>
                        <Run Text="{Binding IsPolling, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: 3-column layout -->
        <Grid Grid.Row="1" Margin="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Address list + Add form -->
            <Border Style="{DynamicResource Card}" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock Text="Monitored Addresses" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                    <!-- Add form -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Address" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding NewMonAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Text="Alias" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding NewMonAlias, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="Type" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataTypes}"
                                      SelectedItem="{Binding NewMonDataType}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Text="Interval" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IntervalPresets}"
                                      SelectedItem="{Binding NewMonIntervalMs}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="4" Text="Color" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ChartColorPalette}"
                                      SelectedItem="{Binding NewMonColor}" Margin="0,0,0,4">
                                    <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="16" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Row="5" Grid.ColumnSpan="2" Content="+ Add Address"
                                    Style="{DynamicResource Button.Primary}" Margin="0,4,0,0"
                                    Command="{Binding AddMonitoredAddressCommand}" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>

                    <!-- Address list -->
                    <ListBox ItemsSource="{Binding MonitoredAddresses}" Background="Transparent"
                             BorderThickness="0" Margin="0,0,0,0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,2"
                                        Background="{DynamicResource Brush.Surface2}"
                                        CornerRadius="{DynamicResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding SeriesColor, Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Text3}">
                                                <Run Text="{Binding Address}"/><Run Text=" | "/><Run Text="{Binding DataType}"/><Run Text=" | "/><Run Text="{Binding IntervalMs}"/><Run Text="ms"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Style="{DynamicResource Button.Text}"
                                                FontSize="12" Padding="4,2"
                                                Command="{Binding DataContext.RemoveMonitoredAddressCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CENTER: Chart -->
            <Border Style="{DynamicResource Card}" Grid.Column="1" Margin="4,0">
                <DockPanel>
                    <TextBlock Text="Real-time Trend" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}">
                        <controls:RealtimeChart x:Name="RealtimeChartControl"
                                                Data="{Binding MonitoredAddresses}"
                                                TimeWindowSeconds="{Binding ChartTimeWindowSeconds}"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- RIGHT: Current values + Log -->
            <Border Style="{DynamicResource Card}" Grid.Column="2" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock Text="Current Values" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                    <!-- Values list -->
                    <ListBox ItemsSource="{Binding MonitoredAddresses}" Background="Transparent"
                             BorderThickness="0" DockPanel.Dock="Top"
                             MaxHeight="300"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,2"
                                        Background="{DynamicResource Brush.Surface2}"
                                        CornerRadius="{DynamicResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding SeriesColor, Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource Brush.Text3}"/>
                                            <TextBlock Text="{Binding CurrentValueText}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       FontFamily="Consolas, Courier New"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding Quality, Converter={StaticResource QualityToColor}}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" Foreground="{DynamicResource Brush.Text3}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Log section -->
                    <Separator DockPanel.Dock="Top" Background="{DynamicResource Brush.Line}" Margin="0,8,0,8"/>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Log" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                            <Button Content="Clear" Style="{DynamicResource Button.Text}" HorizontalAlignment="Right"
                                    Command="{Binding ClearLogCommand}" FontSize="11" Padding="6,4"/>
                        </Grid>
                        <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="6">
                            <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text2}"
                                     FontFamily="Consolas, Courier New" FontSize="11"
                                     ItemsSource="{Binding LogLines}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
