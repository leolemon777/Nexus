<Page x:Class="Nexus.App.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Nexus.App.Views"
      xmlns:controls="clr-namespace:Nexus.App.Controls"
      Background="{DynamicResource Brush.Bg}">
    <Page.Resources>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <local:NonZeroToVisibleConverter x:Key="NonZeroToVisible"/>
        <local:BoolToColorConverter x:Key="BoolToColor"/>
        <local:QualityToColorConverter x:Key="QualityToColor"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Style="{DynamicResource Card}" Margin="12,12,12,0">
            <WrapPanel>
                <Button Style="{DynamicResource Button.Primary}" Margin="0,0,8,4"
                        Command="{Binding TogglePollingCommand}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶ 开始"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                            <Setter Property="Text" Value="⏸ 停止"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button Content="导出 CSV" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,4"
                        Command="{Binding ExportCsvCommand}"/>
                <Button Content="导出 JSON" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,4"
                        Command="{Binding ExportJsonCommand}"/>
                <Button Content="清空历史" Style="{DynamicResource Button.Ghost}" Margin="0,0,8,4"
                        Command="{Binding ClearHistoryCommand}"/>
                <Button Content="清空全部" Style="{DynamicResource Button.Danger}" Margin="0,0,8,4"
                        Command="{Binding ClearAllMonitoredAddressesCommand}"/>
                <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="{DynamicResource Radius.Md}"
                        Padding="12,6" VerticalAlignment="Center" Margin="0,0,8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="窗口(秒): " Style="{DynamicResource Body}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ChartTimeWindowSeconds}" Style="{DynamicResource Body}"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsPolling, Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Style="{DynamicResource Body}" VerticalAlignment="Center">
                        <Run Text="地址数: "/>
                        <Run Text="{Binding MonitoredCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" | 轮询: "/>
                        <Run Text="{Binding IsPolling, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 直接写入 -->
        <Border Style="{DynamicResource Card}" Margin="12,4,12,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="写入" FontWeight="Bold" Foreground="{DynamicResource Brush.Warn}" 
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="地址" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Style="{DynamicResource Input}" Width="120" Margin="0,0,16,0"
                         Text="{Binding WriteAddress, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="类型" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox MinWidth="100" Margin="0,0,16,0"
                          ItemsSource="{Binding WriteDataTypes}" SelectedItem="{Binding WriteDataType}"/>
                <TextBlock Text="值" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Style="{DynamicResource Input}" Width="120" Margin="0,0,16,0"
                         Text="{Binding WriteValue, UpdateSourceTrigger=LostFocus}"/>
                <Button Content="写入" Style="{DynamicResource Button.Danger}" 
                        Command="{Binding WriteToMonitorCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Main content: 3-column layout -->
        <Grid Grid.Row="1" Margin="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Address list + Add form -->
            <Border Style="{DynamicResource Card}" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock Text="监控地址" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                    <!-- Add form -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="地址" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding NewMonAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Text="别名" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding NewMonAlias, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="类型" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataTypes}"
                                      SelectedItem="{Binding NewMonDataType}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="3" Text="间隔" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IntervalPresets}"
                                      SelectedItem="{Binding NewMonIntervalMs}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="4" Text="颜色" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ChartColorPalette}"
                                      SelectedItem="{Binding NewMonColor}" Margin="0,0,0,4">
                                    <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="16" Height="12" RadiusX="2" RadiusY="2" Margin="0,0,6,0">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Row="5" Grid.ColumnSpan="2" Content="+ 添加地址"
                                    Style="{DynamicResource Button.Primary}" Margin="0,4,0,0"
                                    Command="{Binding AddMonitoredAddressCommand}" HorizontalAlignment="Stretch"/>

                            <!-- 批量导入：弹出输入框 -->
                            <Button Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="0"
                                    Content="📋 批量导入"
                                    Style="{DynamicResource Button.Ghost}" Margin="0,4,0,0"
                                    Click="BatchImport_Click" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>

                    <!-- 地址分组 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="地址分组" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                            <Button Content="+ 新建组" Style="{DynamicResource Button.Text}" HorizontalAlignment="Right"
                                    Command="{Binding AddGroupCommand}" FontSize="11" Padding="6,4"/>
                        </Grid>
                        <TreeView Background="Transparent" BorderThickness="0" MaxHeight="120">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeViewItem Header="全部地址" IsExpanded="True">
                                <!-- This will show the flat address list below -->
                            </TreeViewItem>
                        </TreeView>
                    </DockPanel>

                    <!-- Address list -->
                    <ListBox ItemsSource="{Binding MonitoredAddresses}" Background="Transparent"
                             BorderThickness="0" Margin="0,0,0,0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,2"
                                        Background="{DynamicResource Brush.Surface2}"
                                        CornerRadius="{DynamicResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding SeriesColor, Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Brush.Text}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Text3}">
                                                <Run Text="{Binding Address}"/><Run Text=" | "/><Run Text="{Binding DataType}"/><Run Text=" | "/><Run Text="{Binding IntervalMs}"/><Run Text="ms"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Style="{DynamicResource Button.Text}"
                                                FontSize="12" Padding="4,2"
                                                Command="{Binding DataContext.RemoveMonitoredAddressCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CENTER: Chart -->
            <Border Style="{DynamicResource Card}" Grid.Column="1" Margin="4,0">
                <DockPanel>
                    <TextBlock Text="实时趋势" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}">
                        <controls:RealtimeChart x:Name="RealtimeChartControl"
                                                Data="{Binding MonitoredAddresses}"
                                                TimeWindowSeconds="{Binding ChartTimeWindowSeconds}"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- RIGHT: Current values + Log -->
            <Border Style="{DynamicResource Card}" Grid.Column="2" Margin="4,0,0,0">
                <DockPanel>
                    <TextBlock Text="当前值" Style="{DynamicResource Label}" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                    <!-- Values list -->
                    <ListBox ItemsSource="{Binding MonitoredAddresses}" Background="Transparent"
                             BorderThickness="0" DockPanel.Dock="Top"
                             MaxHeight="300"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,2"
                                        Background="{DynamicResource Brush.Surface2}"
                                        CornerRadius="{DynamicResource Radius.Sm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding SeriesColor, Converter={x:Static local:StringToColorConverter.Instance}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource Brush.Text3}"/>
                                            <TextBlock Text="{Binding CurrentValueText}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       FontFamily="Consolas, Courier New"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,4,0">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding Quality, Converter={StaticResource QualityToColor}}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Quality}" FontSize="10" Foreground="{DynamicResource Brush.Text3}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Write section -->
                    <Separator DockPanel.Dock="Top" Background="{DynamicResource Brush.Line}" Margin="0,8,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="写入" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="地址" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding WriteAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Text="类型" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WriteDataTypes}"
                                      SelectedItem="{Binding WriteDataType}" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Text="值" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{DynamicResource Input}"
                                     Text="{Binding WriteValue, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>

                            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="写入"
                                    Style="{DynamicResource Button.Primary}" Margin="0,4,0,0"
                                    Command="{Binding WriteToMonitorCommand}" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>

                    <!-- 报警历史 -->
                    <Separator DockPanel.Dock="Top" Background="{DynamicResource Brush.Line}" Margin="0,4,0,4"/>
                    <DockPanel DockPanel.Dock="Top">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="报警历史" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="声音" IsChecked="{Binding AlarmSoundEnabled}" 
                                          VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <Button Content="清空" Style="{DynamicResource Button.Text}" 
                                        Command="{Binding ClearAlarmHistoryCommand}" FontSize="11" Padding="6,4"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="6" MaxHeight="120">
                            <ListBox Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Warn}"
                                     FontFamily="Consolas" FontSize="11"
                                     ItemsSource="{Binding AlarmHistory}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </DockPanel>

                    <!-- Log section -->
                    <Separator DockPanel.Dock="Top" Background="{DynamicResource Brush.Line}" Margin="0,8,0,8"/>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="日志" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                            <Button Content="清空" Style="{DynamicResource Button.Text}" HorizontalAlignment="Right"
                                    Command="{Binding ClearLogCommand}" FontSize="11" Padding="6,4"/>
                        </Grid>
                        <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="6">
                            <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Brush.Text2}"
                                     FontFamily="Consolas, Courier New" FontSize="11"
                                     ItemsSource="{Binding LogLines}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
