<Page x:Class="Nexus.App.Views.SimulatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>

            <!-- 模拟器控制 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Modbus TCP 模拟器" Style="{DynamicResource Label}" Margin="0,0,0,8"/>
                    <TextBlock Text="本地模拟 PLC 设备，无需真实硬件即可测试 Modbus 通讯"
                               Foreground="{DynamicResource Brush.Text3}" FontSize="13" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="地址" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource Input}" Width="120" Margin="0,0,8,0"
                                 Text="{Binding Host, Mode=OneWay}" IsReadOnly="True" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="端口" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" Style="{DynamicResource Input}" Width="80"
                                 Text="{Binding Port, UpdateSourceTrigger=LostFocus}"/>

                        <Button Grid.Column="4" Content="▶ 启动" Style="{DynamicResource Button.Primary}"
                                MinWidth="90" Margin="12,0,0,0" Command="{Binding StartCommand}"/>
                        <Button Grid.Column="5" Content="■ 停止" Style="{DynamicResource Button.Danger}"
                                MinWidth="90" Margin="8,0,0,0" Command="{Binding StopCommand}"/>
                    </Grid>

                    <!-- 状态指示 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Text3}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{DynamicResource Body}"
                                   FontWeight="Bold" Margin="8,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{DynamicResource Body}" VerticalAlignment="Center">
                            <Run Text="连接数: "/><Run Text="{Binding ConnectionCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </Grid>

                    <!-- 延迟模拟 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模拟延迟" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding SimulatedLatencyMs, Mode=TwoWay}"
                                TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="{Binding SimulatedLatencyMs, Mode=OneWay}"/><Run Text=" ms"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 预置数据说明 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="预置数据" Style="{DynamicResource Label}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PresetInfo}" Style="{DynamicResource Body}"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}"/>

                    <TextBlock Text="使用方法" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"
                               Margin="0,12,0,6"/>
                    <TextBlock Style="{DynamicResource Body}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}">
                        <Run Text="1. 点击「启动」按钮"/><LineBreak/>
                        <Run Text="2. 切换到 Modbus TCP 页面"/><LineBreak/>
                        <Run Text="3. IP 填 127.0.0.1，端口填 "/><Run Text="{Binding Port, Mode=OneWay}"/><LineBreak/>
                        <Run Text="4. 点击「连接」后即可读取预置数据"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="模拟器日志" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                        <Button Content="清空" Style="{DynamicResource Button.Text}" HorizontalAlignment="Right"
                                Command="{Binding ClearLogCommand}"/>
                    </Grid>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="12" Height="180">
                        <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Text2}"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
