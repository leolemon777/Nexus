<Page x:Class="Nexus.App.Views.DataLoggerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>

            <!-- 控制面板 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="SQLite 数据记录器" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="▶ 启动记录" Style="{DynamicResource Button.Primary}" Command="{Binding StartLoggingCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="⏹ 停止记录" Style="{DynamicResource Button.Ghost}" Command="{Binding StopLoggingCommand}" Margin="0,0,16,0"/>
                        <Button Grid.Column="2" Content="🔄 刷新" Style="{DynamicResource Button.Text}" Command="{Binding RefreshStatsCommand}" Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="待写入:" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBlock Text="{Binding PendingCount}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="总计:" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            <TextBlock Text="{Binding TotalLogged}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="5" Content="📄 导出 CSV" Style="{DynamicResource Button.Text}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="6" Content="📋 导出 JSON" Style="{DynamicResource Button.Text}" Command="{Binding ExportJsonCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Body}" Foreground="{DynamicResource Brush.Text3}" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- 最近记录 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="最近记录" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="8" MinHeight="120">
                        <ListView ItemsSource="{Binding RecentEntries}" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" FontFamily="Consolas" FontSize="12"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="协议" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Protocol}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="地址" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Address}" FontFamily="Consolas"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="类型" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DataType}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="值" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Value}" FontWeight="Bold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="质量" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Quality}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="日志" Style="{DynamicResource Label}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="12" Height="120">
                        <ListBox Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Text2}"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 ItemsSource="{Binding LogLines}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
