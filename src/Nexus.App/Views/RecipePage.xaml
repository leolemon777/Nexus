<Page x:Class="Nexus.App.Views.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>

            <!-- 配方列表 + 新建 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="配方管理" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                        <Button Content="刷新" Style="{DynamicResource Button.Text}" HorizontalAlignment="Right" Command="{Binding RefreshListCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="配方名称" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource Input}" Text="{Binding RecipeName, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="描述" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource Input}" Text="{Binding RecipeDescription, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Content="💾 保存新配方" Style="{DynamicResource Button.Primary}" Command="{Binding NewRecipeCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="8" MinHeight="60">
                        <ListView ItemsSource="{Binding RecipeList}" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="配方名" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="Medium"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="操作" Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="加载" FontSize="11" Padding="8,2" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.LoadRecipeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="导出" FontSize="11" Padding="8,2" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ExportRecipeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" FontSize="11" Padding="8,2" Foreground="#FF4444"
                                                            Command="{Binding DataContext.DeleteRecipeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 参数列表 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="参数列表" Style="{DynamicResource Label}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="参数名" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource Input}" Text="{Binding ParamName, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="地址" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource Input}" Text="{Binding ParamAddress, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0" MinWidth="100">
                            <TextBlock Text="类型" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding ParamDataType, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="值" Style="{DynamicResource Body}" Margin="0,0,0,4"/>
                            <TextBox Style="{DynamicResource Input}" Text="{Binding ParamValue, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Content="➕ 添加" Style="{DynamicResource Button.Primary}" Command="{Binding AddParameterCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="8" MinHeight="40">
                        <ListView ItemsSource="{Binding CurrentParameters}" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="地址" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Address}" FontFamily="Consolas"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="类型" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding DataType}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="值" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Value}" FontWeight="Bold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="操作" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" FontSize="11" Padding="8,2" Foreground="#FF4444"
                                                        Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="操作日志" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="12" Height="120">
                        <ListBox Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Text2}"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
