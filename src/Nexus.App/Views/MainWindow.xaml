<Window x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nexus.App"
        Title="Nexus — Industrial Communication"
        Width="1400" Height="900" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="{DynamicResource Font.Family}"
        Background="{DynamicResource Brush.Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧导航栏 ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo 区域 -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="NEXUS" FontSize="22" FontWeight="Black" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="Industrial Communication" FontSize="10" Foreground="{DynamicResource Brush.Text3}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 导航列表 -->
                <ListBox x:Name="NavList" DockPanel.Dock="Top"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Brush.Text}"
                         Padding="12,8">

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NavItem}">
                            <Grid Height="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text2}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource Radius.Md}" Padding="4,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 底部版本信息 -->
                <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 · MIT License" FontSize="10"
                           Foreground="{DynamicResource Brush.Text3}" Margin="20,0,20,12" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═══ 右侧内容区 ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNav.Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedNav.Label}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:ThemeManager.CurrentColor}, StringFormat='🎨 {}'}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Source={x:Static local:ThemeManager.CurrentColor}}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="🛡 MIT" FontSize="11" Foreground="{DynamicResource Brush.Ok}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="FREE" FontWeight="Black" FontSize="11"
                                   Foreground="{DynamicResource Brush.OnAccent}" Background="{DynamicResource Brush.Accent}"
                                   Padding="8,3" Margin="0,0,0,0">
                            <TextBlock.Resources>
                                <Style TargetType="TextBlock"/>
                            </TextBlock.Resources>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容页容器 -->
            <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="0"/>
        </Grid>
    </Grid>
</Window>
