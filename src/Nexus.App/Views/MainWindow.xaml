<Window x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nexus.App"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="Nexus — 工控通讯调试工具"
        Width="1440" Height="920" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="{DynamicResource Font.Family}"
        Background="{DynamicResource Brush.Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧导航栏 ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- ── Logo 区域 ── -->
                <Border DockPanel.Dock="Top" Padding="14,12,14,10" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="32" Height="32"
                                Background="{DynamicResource Brush.Accent}" CornerRadius="{DynamicResource Radius.Md}"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="N" FontWeight="Black" FontSize="16"
                                       Foreground="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" FontSize="16" FontWeight="Black"
                                       Foreground="{DynamicResource Brush.Text}" LineHeight="20"/>
                            <TextBlock Text="工控通讯库" FontSize="9.5"
                                       Foreground="{DynamicResource Brush.Text3}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── 底部状态栏 ── -->
                <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="v0.1.0 · MIT" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10">
                            <Run Text="🛡 " Foreground="{DynamicResource Brush.Ok}"/>
                            <Run Text="开源免费" Foreground="{DynamicResource Brush.Text3}"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── TreeView 分组导航 ── -->
                <TreeView x:Name="NavTree"
                          ItemsSource="{Binding NavGroups}"
                          Background="Transparent" BorderThickness="0"
                          Padding="6,6,6,6"
                          Foreground="{DynamicResource Brush.Text}"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="False"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <!-- Group header -->
                                            <Border x:Name="groupBg" Background="Transparent"
                                                    CornerRadius="{DynamicResource Radius.Sm}" Padding="6,5"
                                                    Cursor="Hand" Margin="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Logo / emoji 图标 -->
                                                    <Grid Width="28" Height="20">
                                                        <TextBlock Text="{Binding Icon}" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding EmojiVisible}"/>
                                                        <Image Source="{Binding IconSource}" Stretch="Uniform"
                                                               Width="22" Height="18"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding LogoVisible}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text3}"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Expand/collapse chevron -->
                                                    <Path x:Name="expander" Grid.Column="2"
                                                          Data="M 4,0 L 8,4 L 4,8" Stroke="{DynamicResource Brush.Text3}"
                                                          StrokeThickness="1.5" Fill="Transparent"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="expanderRotate" Angle="90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>

                                            <!-- Children: animated via LayoutTransform ScaleY -->
                                            <Border x:Name="itemsHost" ClipToBounds="True" Margin="6,0,0,0">
                                                <StackPanel x:Name="itemsPanel" Opacity="0">
                                                    <StackPanel.LayoutTransform>
                                                        <ScaleTransform x:Name="itemsScale" ScaleY="0"/>
                                                    </StackPanel.LayoutTransform>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <!-- ── Collapse animation ── -->
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation Storyboard.TargetName="expanderRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="itemsScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="0" Duration="0:0:0.2">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="itemsPanel"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="expanderRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             To="90" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="itemsScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="itemsPanel"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>

                                            <!-- ── Group header hover ── -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="groupBg" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Resources>
                                <!-- Override child TreeViewItem: flat, no chrome -->
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <ItemsPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Style.Resources>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <!-- Group Header Template (NavGroup) -->
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:NavGroup}" ItemsSource="{Binding Items}">
                            <ContentPresenter Content="{Binding}"/>

                            <!-- Child item template (NavItem) -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:NavItem}">
                                    <Border x:Name="itemBg" Background="Transparent"
                                            CornerRadius="{DynamicResource Radius.Sm}" Padding="8,6"
                                            Margin="0,1" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="itemLabel" Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                       Foreground="{DynamicResource Brush.Text2}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBg" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                </TreeView>

            </DockPanel>
        </Border>

        <!-- ═══ 右侧内容区 ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 顶栏 ── -->
            <Border Grid.Row="0" Padding="16,10" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 左：当前页信息 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TopBarIcon" Text="" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TopBarTitle" Text="选择协议开始调试" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TopBarSubtitle" Text="" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center" Margin="12,1,0,0"/>
                    </StackPanel>
                    <!-- 右：状态 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:ThemeManager.CurrentColor}, StringFormat='🎨 {}'}"
                                   FontSize="11" Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Source={x:Static local:ThemeManager.CurrentColor}}"
                                   FontSize="11" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="FREE" FontWeight="Black" FontSize="10"
                                   Foreground="{DynamicResource Brush.OnAccent}" Background="{DynamicResource Brush.Ok}"
                                   Padding="8,3" Margin="0,0,0,0">
                            <TextBlock.Resources>
                                <Style TargetType="TextBlock"/>
                            </TextBlock.Resources>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 内容页容器 ── -->
            <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
