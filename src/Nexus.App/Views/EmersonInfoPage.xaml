<Page x:Class="Nexus.App.Views.EmersonInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Emerson 通信说明" Style="{DynamicResource Label}" Margin="0,0,0,12"/>
                    <TextBlock Style="{DynamicResource Body}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,8"
                               Text="Emerson DeltaV / Ovation 是 DCS 系统,现场主流通过 OPC UA 通信。请使用 OPC UA 客户端(Nexus.OpcUa)接入。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
