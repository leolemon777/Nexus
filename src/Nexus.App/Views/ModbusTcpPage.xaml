<Page x:Class="Nexus.App.Views.ModbusTcpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Brush.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- 内置 Server -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="内置 Modbus Server（虚拟 PLC）" Style="{DynamicResource Label}"/>
                            <TextBlock Style="{DynamicResource Body}" Margin="0,4,0,0"
                                       Text="绑定 127.0.0.1:15020，预置线圈/保持/输入/离散 4 区数据，便于无硬件调试"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="启动 Server"
                                Style="{DynamicResource Button.Primary}" Margin="0,0,8,0"
                                Command="{Binding StartServerCommand}"/>
                        <Button Grid.Column="2" Content="停止 Server"
                                Style="{DynamicResource Button.Ghost}" Margin="0,0,16,0"
                                Command="{Binding StopServerCommand}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Ok}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Text" Value="未启动"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Text" Value="运行中"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 连接配置 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="连接配置" Style="{DynamicResource Label}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="IP" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource Input}" Width="160" Margin="0,0,16,0"
                                     Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="端口" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource Input}" Width="80" Margin="0,0,16,0"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="站号" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{DynamicResource Input}" Width="60"
                                     Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="连接" Style="{DynamicResource Button.Primary}" Margin="12,0,0,0"
                                Command="{Binding ConnectCommand}"/>
                        <Button Grid.Column="2" Content="断开" Style="{DynamicResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding DisconnectCommand}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Ok}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatus}" Style="{DynamicResource Body}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 数据读写 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="数据读写" Style="{DynamicResource Label}" Margin="0,0,0,14"/>

                    <!-- 读取 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="读取" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource Input}" Margin="0,0,8,0"
                                 Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="2" Width="110" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataTypes}"
                                  SelectedItem="{Binding DataType}"/>
                        <Button Grid.Column="3" Content="读取" Style="{DynamicResource Button.Primary}" Margin="0,0,16,0"
                                Command="{Binding ReadCommand}"/>
                        <Border Grid.Column="4" Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="20,8" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <TextBlock Text="{Binding LastResult}" Style="{DynamicResource Readout}" FontSize="24"/>
                        </Border>
                    </Grid>

                    <!-- 写入 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="写入" FontWeight="Bold" Foreground="{DynamicResource Brush.Warn}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{DynamicResource Input}" Margin="0,0,8,0"
                                 Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="值" Style="{DynamicResource Body}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" Style="{DynamicResource Input}" Margin="0,0,8,0"
                                 Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="4" Width="110" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataTypes}"
                                  SelectedItem="{Binding DataType}"/>
                        <Button Grid.Column="5" Content="写入" Style="{DynamicResource Button.Danger}"
                                Command="{Binding WriteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 通讯日志 -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="通讯日志" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="清空" Style="{DynamicResource Button.Text}" Margin="0,0,4,0"
                                    Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource Brush.Bg}" CornerRadius="{DynamicResource Radius.Md}" Padding="12" Height="240">
                        <ListBox Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Text2}"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
