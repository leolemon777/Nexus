<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Color theme: spotify -->
  <Color x:Key="Color.Bg">#0A0A0A</Color>
  <Color x:Key="Color.Surface">#121212</Color>
  <Color x:Key="Color.Surface2">#181818</Color>
  <Color x:Key="Color.Surface3">#222222</Color>
  <Color x:Key="Color.Line">#17FFFFFF</Color>
  <Color x:Key="Color.Line2">#29FFFFFF</Color>
  <Color x:Key="Color.Text">#F2F2F2</Color>
  <Color x:Key="Color.Text2">#A7A7A7</Color>
  <Color x:Key="Color.Text3">#6A6A6A</Color>
  <Color x:Key="Color.Accent">#1DB954</Color>
  <Color x:Key="Color.Accent2">#4FE07E</Color>
  <Color x:Key="Color.AccentSoft">#261DB954</Color>
  <Color x:Key="Color.AccentLine">#801DB954</Color>
  <Color x:Key="Color.Ok">#1DB954</Color>
  <Color x:Key="Color.Warn">#E0B24E</Color>
  <Color x:Key="Color.Alarm">#E0584E</Color>
  <Color x:Key="Color.OkSoft">#261DB954</Color>
  <Color x:Key="Color.WarnSoft">#26E0B24E</Color>
  <Color x:Key="Color.AlarmSoft">#26E0584E</Color>
  <Color x:Key="Color.OnAccent">#04210F</Color>
  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}"/>
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}"/>
  <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}"/>
  <SolidColorBrush x:Key="Brush.Line2" Color="{StaticResource Color.Line2}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}"/>
  <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource Color.Text3}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}"/>
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
  <SolidColorBrush x:Key="Brush.AccentLine" Color="{StaticResource Color.AccentLine}"/>
  <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}"/>
  <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}"/>
  <SolidColorBrush x:Key="Brush.Alarm" Color="{StaticResource Color.Alarm}"/>
  <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.OkSoft}"/>
  <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}"/>
  <SolidColorBrush x:Key="Brush.AlarmSoft" Color="{StaticResource Color.AlarmSoft}"/>
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/>
  <LinearGradientBrush x:Key="Brush.AccentGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource Color.Accent2}" Offset="0"/>
    <GradientStop Color="{StaticResource Color.Accent}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.SurfaceGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource Color.Surface2}" Offset="0"/>
    <GradientStop Color="{StaticResource Color.Surface}" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>