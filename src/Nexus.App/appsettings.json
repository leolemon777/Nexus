{
  "Modbus": {
    "DefaultIp": "127.0.0.1",
    "DefaultPort": 502,
    "DefaultSlaveId": 1,
    "DefaultTimeoutMs": 5000,
    "VirtualServerPort": 15020,
    "AutoStartVirtualServer": false,
    "DefaultByteOrder": "BigEndian",
    "UseConnectionPool": false,
    "ConnectionPoolSize": 4
  },
  "Logging": {
    "Directory": "",
    "FileName": "nexus.log",
    "MaxFileSizeBytes": 1048576,
    "MaxFiles": 10,
    "BufferCapacity": 1000,
    "MinimumLevel": "Info"
  },
  "Theme": {
    "Palette": "mono",
    "Accent": "soft"
  }
}
