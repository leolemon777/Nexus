<UserControl x:Class="Nexus.App.Controls.ConnectionStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal">
        <!-- Animated status circle -->
        <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Text3}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connected">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Ok}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connecting">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Warn}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Disconnected">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Alarm}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.3" Duration="0:0:1"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Status text with color coding -->
        <TextBlock x:Name="StatusTextBlock" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}"/>
                    <Setter Property="FontSize" Value="{DynamicResource Font.Size}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connected">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Connecting">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Disconnected">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Alarm}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Endpoint display -->
        <TextBlock x:Name="EndpointTextBlock" Style="{DynamicResource Body}" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text3}"/>

        <!-- Duration display -->
        <TextBlock x:Name="DurationTextBlock" Style="{DynamicResource Body}" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text3}"/>
    </StackPanel>
</UserControl>
