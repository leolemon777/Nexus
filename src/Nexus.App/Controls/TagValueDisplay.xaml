<UserControl x:Class="Nexus.App.Controls.TagValueDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonDown="OnCopyClick">

    <Border Background="{DynamicResource Brush.Surface2}"
            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Md}" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Quality indicator bar -->
            <Border x:Name="QualityBar" Grid.RowSpan="2" Width="3" CornerRadius="1.5" Margin="0,0,10,0"
                    VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Ok}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Stale">
                                <Setter Property="Background" Value="{DynamicResource Brush.Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource Brush.Alarm}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Bad">
                                <Setter Property="Background" Value="{DynamicResource Brush.Alarm}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Address + DataType -->
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding Address, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="{Binding DataType, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Brush.Text3}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Value -->
            <TextBlock Grid.Column="1" Grid.Row="1" Margin="0,2,0,0"
                       Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16" FontWeight="Light" FontFamily="{DynamicResource Font.Family}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Stale">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Alarm}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Bad">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Alarm}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Quality + Timestamp -->
            <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="11" HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Stale">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Alarm}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quality, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Bad">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Alarm}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Timestamp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource Brush.Text3}" FontSize="10" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
