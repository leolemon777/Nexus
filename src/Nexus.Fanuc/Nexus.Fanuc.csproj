<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Nexus.Fanuc</RootNamespace>
    <AssemblyName>Nexus.Fanuc</AssemblyName>
    <Description>Nexus FANUC FOCAS/Ethernet protocol implementation</Description>
<Version>1.0.0</Version>
    <Authors>Nexus Contributors</Authors>
    <Company>Nexus</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nexus-industrial/nexus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>industrial-communication PLC protocol Fanuc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj"/>
  </ItemGroup>
</Project>
