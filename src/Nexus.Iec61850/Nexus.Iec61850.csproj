<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Nexus.Iec61850</RootNamespace>
    <AssemblyName>Nexus.Iec61850</AssemblyName>
    <Description>Nexus IEC 61850 — MMS/GOOSE protocol for smart substations</Description>
    <Version>1.0.0</Version>
    <Authors>Nexus Contributors</Authors>
    <Company>Nexus</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nexus-industrial/nexus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>industrial-communication SCADA power substation IEC61850 MMS GOOSE</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj"/>
  </ItemGroup>
</Project>
