<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Nexus.Toshiba</RootNamespace>
    <AssemblyName>Nexus.Toshiba</AssemblyName>
    <Description>Nexus Toshiba V-series PLC Modbus-variant protocol implementation</Description>
    <PackageTags>industrial-communication PLC protocol Toshiba V200</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSource>true</IncludeSource>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj"/>
    <ProjectReference Include="..\Nexus.Modbus\Nexus.Modbus.csproj"/>
  </ItemGroup>
</Project>
