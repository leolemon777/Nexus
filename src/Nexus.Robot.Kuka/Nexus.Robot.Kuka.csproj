<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Nexus.Robot.Kuka</RootNamespace>
    <Description>Nexus Robot KUKA — KUKA 机器人 TCP/VarProxy 通讯客户端</Description>
    <Version>1.0.0</Version>
    <Authors>Nexus Contributors</Authors>
    <Company>Nexus</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nexus-industrial/nexus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>industrial-communication robot KUKA protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
  </ItemGroup>
</Project>
